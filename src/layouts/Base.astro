---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Id of the page's <main>, target of the "skip to content" link */
	mainId?: string;
	skipText?: string;
}

const { title, description, mainId = 'questions', skipText = 'Ir para as perguntas' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fbf5f2" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href={`#${mainId}`}>{skipText}</a>
		<slot />
	</body>
</html>
