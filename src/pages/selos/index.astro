---
// This folder is named after the public pt-BR address (/selos): the folder name IS the URL.
import Seals from '../../components/seals/Seals';
import Base from '../../layouts/Base.astro';
import { listDecks } from '../../lib/decks';

const decks = await listDecks();
---

<Base
	title="Meus selos | Curiô"
	description="Um selo para cada tema que você descobriu por inteiro no Curiô."
	mainId="content"
	skipText="Ir para os selos"
>
	<Seals client:load decks={decks} />
	<noscript>
		<p class="no-js">O Curiô precisa de JavaScript ligado para mostrar os selos.</p>
	</noscript>
</Base>

<style>
	.no-js {
		position: fixed;
		inset: auto var(--space-sm) var(--space-sm);
		padding: var(--space-sm);
		border-radius: var(--radius-md);
		background: var(--color-panel);
		text-align: center;
	}
</style>
