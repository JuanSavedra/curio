---
// This folder is named after the public pt-BR address (/temas): the folder name IS the URL.
import Topics from '../../components/topics/Topics';
import Base from '../../layouts/Base.astro';
import { listDecks } from '../../lib/decks';

const decks = await listDecks();
---

<Base
	title="Temas | Curiô"
	description="Escolha um tema do Curiô e descubra de ciências a astronomia, uma pergunta curiosa de cada vez."
	mainId="content"
	skipText="Ir para os temas"
>
	<Topics client:load decks={decks} />
	<noscript>
		<p class="no-js">O Curiô precisa de JavaScript ligado para mostrar os temas.</p>
	</noscript>
</Base>

<style>
	.no-js {
		position: fixed;
		inset: auto var(--space-sm) var(--space-sm);
		padding: var(--space-sm);
		border-radius: var(--radius-md);
		background: var(--color-panel);
		text-align: center;
	}
</style>
