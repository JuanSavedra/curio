---
import Feed from '../components/feed/Feed';
import Base from '../layouts/Base.astro';
import { listDecks } from '../lib/decks';

const decks = await listDecks();
---

<Base
	title="Curiô: perguntas que despertam a curiosidade"
	description="Troque o scroll de vídeos curtos por perguntas de ciências, matemática, lógica e mais. Toda resposta vem com uma curiosidade. Grátis e sem anúncios."
>
	<Feed client:load decks={decks} />
	<noscript>
		<p class="no-js">O Curiô precisa de JavaScript ligado para mostrar as perguntas.</p>
	</noscript>
</Base>

<style>
	.no-js {
		position: fixed;
		inset: auto var(--space-sm) var(--space-sm);
		padding: var(--space-sm);
		border-radius: var(--radius-md);
		background: var(--color-panel);
		text-align: center;
	}
</style>
