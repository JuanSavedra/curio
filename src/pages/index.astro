---
import Feed from '../components/feed/Feed';
import Base from '../layouts/Base.astro';
import { listarDecks } from '../lib/decks';

const decks = await listarDecks();
---

<Base
	titulo="Curiô: perguntas que despertam a curiosidade"
	descricao="Troque o scroll de vídeos curtos por perguntas de ciências, matemática, lógica e mais. Toda resposta vem com uma curiosidade. Grátis e sem anúncios."
>
	<Feed client:load decks={decks} />
	<noscript>
		<p class="sem-js">O Curiô precisa de JavaScript ligado para mostrar as perguntas.</p>
	</noscript>
</Base>

<style>
	.sem-js {
		position: fixed;
		inset: auto var(--esp-sm) var(--esp-sm);
		padding: var(--esp-sm);
		border-radius: var(--raio-alt);
		background: var(--cor-painel);
		text-align: center;
	}
</style>
